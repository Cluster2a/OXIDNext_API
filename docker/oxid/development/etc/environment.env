# global settings
PHP_IDE_CONFIG=serverName=oxidnextServer

# MySQL settings
MYSQL_SERVER=mysql-oxidnext-development
MYSQL_PORT_NUMBER=3306
MYSQL_USER=dev
MYSQL_DATABASE=database
MYSQL_PASSWORD=dev
MYSQL_ROOT_PASSWORD=dev


# OXID Settings
OXID_URL=http://graphql.oxidnext.localhost.local
OXID_SHOPDIR=/app/source
OXID_COMPILEDIR=/app/source/tmp

# debugging
PHP_XDEBUG_ENABLED=1
XDEBUG_CONFIG=client_host=172.17.0.1