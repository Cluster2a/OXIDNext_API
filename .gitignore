.DS_Store
node_modules/

# exclude vendoe
/app/oxid/vendor/

# exclude composer.lock
/app/oxid/composer.lock

# exclude var folder
/app/oxid/var/*

# include specific source folders
!/app/oxid/source/
/app/oxid/source/*
!/app/oxid/source/check.html

# metapackages
!/app/oxid/metapackages

# include patches
!/app/oxid/patches

# ignore node modules
node_modules/

# include crons
!/app/oxid/source/bin/
/app/oxid/source/bin/*
!/app/oxid/source/bin/cron_*.php

!/app/oxid/source/.htaccess
!/app/oxid/source/config.inc.php
/app/oxid/oxid.lock

# migration
!/app/oxid/source/migration/
/app/oxid/source/migration/*
!/app/oxid/source/migration/project_data/
!/app/oxid/source/migration/project_migrations.yml

# theme
!/app/oxid/source/Application/
/app/oxid/source/Application/*
!/app/oxid/source/Application/views/
/app/oxid/source/Application/views/*
!/app/oxid/source/Application/views/otto-fischer
/app/oxid/source/Application/views/otto-fischer/node_modules/*

# languages
!/app/oxid/source/Application/translations/
/app/oxid/source/Application/translations/*
!/app/oxid/source/Application/translations/fr/
!/app/oxid/source/Application/translations/it/

# out
!/app/oxid/source/out
/app/oxid/source/out/*
!/app/oxid/source/out/otto-fischer
!/app/oxid/source/out/perfion2oxid

# exclude grunt stuff
/app/oxid/source/out/otto-fischer/src/fonts/
