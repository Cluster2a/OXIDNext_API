/app/oxid/source/out/otto-fischer/src/js/scriptPages.min.js
/app/oxid/source/out/otto-fischer/src/js/scriptPages.min.js.map
/app/oxid/source/out/otto-fischer/src/css/styles.css
/app/oxid/source/out/otto-fischer/src/css/styles.min.css

# grunt
!/app/oxid/source/Gruntfile.coffee
!/app/oxid/source/package.json
!/app/oxid/source/package-lock.json
!/app/oxid/source/grunt/

